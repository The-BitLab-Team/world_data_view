# Copie para backend/.env e ajuste. Todas as variáveis são opcionais.

# Banco. Padrão: SQLite em backend/data/world_data.db (zero configuração).
# Para PostgreSQL: pip install -r requirements-postgres.txt e use, por exemplo:
# WDV_DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/world_data_view

# Origens permitidas no CORS (separadas por vírgula). A API só aceita GET.
WDV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Atualização periódica dos dados dentro do processo da API.
# Com várias réplicas, deixe false e agende "python -m app.cli collect" por cron.
WDV_SCHEDULER_ENABLED=false
WDV_COLLECT_INTERVAL_HOURS=24

# Se o banco estiver vazio ao iniciar, dispara uma coleta em segundo plano.
WDV_BOOTSTRAP_ON_START=false

# HTTP dos coletores.
WDV_HTTP_TIMEOUT=60
WDV_HTTP_RETRIES=3

# Validade do cache em memória das respostas pesadas, em segundos.
WDV_CACHE_TTL_SECONDS=300
