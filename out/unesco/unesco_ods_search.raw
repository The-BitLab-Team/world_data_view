u0625\u0633\u0628\u0627\u0646\u064a\u0629", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "documentid", "description": null, "annotations": {}, "label": "Source document ID", "type": "text", "label_en": "Source document ID", "label_fr": "Identifiant du document source", "label_es": "Identificador del documento fuente", "label_ar": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u0645\u0635\u062f\u0631", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "publishedat", "description": null, "annotations": {}, "label": "Published at", "type": "datetime", "label_en": "Published at", "label_fr": "Date de publication", "label_es": "Fecha de publicaci\u00f3n", "label_ar": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0646\u0634\u0631", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "website", "description": null, "annotations": {}, "label": "Website", "type": "text", "label_en": "Website", "label_fr": "Site web", "label_es": "Sitio web", "label_ar": "\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "social_links", "description": null, "annotations": {}, "label": "Social media links", "type": "text", "label_en": "Social media links", "label_fr": "R\u00e9seaux sociaux", "label_es": "Redes sociales", "label_ar": "\u0631\u0648\u0627\u0628\u0637 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "video", "description": null, "annotations": {}, "label": "Video", "type": "text", "label_en": "Video", "label_fr": "Vid\u00e9o", "label_es": "V\u00eddeo", "label_ar": "\u0641\u064a\u062f\u064a\u0648", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "main_image", "description": null, "annotations": {}, "label": "Main image", "type": "text", "label_en": "Main image", "label_fr": "Image principale", "label_es": "Imagen principal", "label_ar": "\u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "postal_address", "description": null, "annotations": {}, "label": "Postal address", "type": "text", "label_en": "Postal address", "label_fr": "Adresse postale", "label_es": "Direcci\u00f3n postal", "label_ar": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064a\u062f\u064a", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}], "dataset_id": "pbm001", "dataset_uid": "da_cwdrgr", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "World Book Capital", "title_en": "World Book Capital", "title_fr": "Capitale mondiale du livre", "title_es": "Capital Mundial del Libro", "title_ar": "\u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0644\u0644\u0643\u062a\u0627\u0628", "description": "<p>Since 2001, UNESCO has designated one city each year as World Book Capital, starting with Madrid. Designated cities promote books and reading for sustainable and inclusive development, and work on literacy, lifelong learning, copyright protection and freedom of expression through a year of activities.</p><p>Books and storytelling are a legacy of humanity. They are powerful tools for critical thinking, reflection and emancipation. This repository of human wisdom and narratives raises awareness of heritage and cultural diversity, thereby bridging different ages and cultures. Lying at the intersection of culture and education, reading is a vital right that everyone should fully enjoy \u2013 and resonates UNESCO\u2019s long-advocated vision.</p><p>Each record is a World Book Capital: city, country, designation year, introduction, description, slogan, main activities and links.</p>", "description_en": "<p>Since 2001, UNESCO has designated one city each year as World Book Capital, starting with Madrid. Designated cities promote books and reading for sustainable and inclusive development, and work on literacy, lifelong learning, copyright protection and freedom of expression through a year of activities.</p><p>Books and storytelling are a legacy of humanity. They are powerful tools for critical thinking, reflection and emancipation. This repository of human wisdom and narratives raises awareness of heritage and cultural diversity, thereby bridging different ages and cultures. Lying at the intersection of culture and education, reading is a vital right that everyone should fully enjoy \u2013 and resonates UNESCO\u2019s long-advocated vision.</p><p>Each record is a World Book Capital: city, country, designation year, introduction, description, slogan, main activities and links.</p>", "description_fr": "<p>Depuis 2001, l'UNESCO d\u00e9signe chaque ann\u00e9e une ville Capitale mondiale du livre, \u00e0 commencer par Madrid. Les villes d\u00e9sign\u00e9es promeuvent le livre et la lecture au service d'un d\u00e9veloppement durable et inclusif, et agissent en faveur de l'alphab\u00e9tisation, de l'apprentissage tout au long de la vie, de la protection du droit d'auteur et de la libert\u00e9 d'expression \u00e0 travers une ann\u00e9e d'activit\u00e9s.</p><p>Les livres et les r\u00e9cits constituent un h\u00e9ritage de l\u2019humanit\u00e9. Ce sont des outils puissants au service de la pens\u00e9e critique, de la r\u00e9flexion et de l\u2019\u00e9mancipation. Ce vivier de sagesse humaine et de r\u00e9cits sensibilise au patrimoine et \u00e0 la diversit\u00e9 culturelle, jetant ainsi des ponts entre les diff\u00e9rentes g\u00e9n\u00e9rations et cultures. Situ\u00e9e \u00e0 la crois\u00e9e de la culture et de l\u2019\u00e9ducation, la lecture est un droit fondamental dont chacun devrait pouvoir jouir pleinement \u2013 ce qui fait \u00e9cho \u00e0 la vision d\u00e9fendue de longue date par l\u2019UNESCO.</p><p>Chaque enregistrement correspond \u00e0 une Capitale mondiale du livre : ville, pays, ann\u00e9e de d\u00e9signation, pr\u00e9sentation, description, slogan, principales activit\u00e9s et liens.</p>", "description_es": "<p>Desde 2001, la UNESCO designa cada a\u00f1o una ciudad como Capital Mundial del Libro, empezando por Madrid. Las ciudades designadas promueven el libro y la lectura en favor de un desarrollo sostenible e inclusivo, y trabajan en la alfabetizaci\u00f3n, el aprendizaje a lo largo de toda la vida, la protecci\u00f3n del derecho de autor y la libertad de expresi\u00f3n mediante un a\u00f1o de actividades.</p><p>Los libros y la narraci\u00f3n de historias son un legado de la humanidad. Son herramientas poderosas para el pensamiento cr\u00edtico, la reflexi\u00f3n y la emancipaci\u00f3n. Este repositorio de sabidur\u00eda y relatos humanos fomenta la concienciaci\u00f3n sobre el patrimonio y la diversidad cultural, tendiendo as\u00ed un puente entre diferentes \u00e9pocas y culturas. Situada en la encrucijada entre la cultura y la educaci\u00f3n, la lectura es un derecho fundamental del que todo el mundo deber\u00eda disfrutar plenamente, lo que se hace eco de la visi\u00f3n que la UNESCO defiende desde hace tiempo.</p><p>Cada registro corresponde a una Capital Mundial del Libro: ciudad, pa\u00eds, a\u00f1o de designaci\u00f3n, presentaci\u00f3n, descripci\u00f3n, lema, actividades principales y enlaces.</p>", "description_ar": "<p>\u0645\u0646\u0630 \u0639\u0627\u0645 2001\u060c \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u064a\u0648\u0646\u0633\u0643\u0648 \u0643\u0644 \u0639\u0627\u0645 \u0645\u062f\u064a\u0646\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0627\u0635\u0645\u0629\u064b \u0639\u0627\u0644\u0645\u064a\u0629 \u0644\u0644\u0643\u062a\u0627\u0628\u060c \u0648\u0643\u0627\u0646\u062a \u0645\u062f\u0631\u064a\u062f \u0623\u0648\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0645\u062f\u0646. \u0648\u062a\u0639\u0645\u0644 \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0645\u062e\u062a\u0627\u0631\u0629 \u0639\u0644\u0649 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0645\u0646 \u0623\u062c\u0644 \u062a\u0646\u0645\u064a\u0629 \u0645\u0633\u062a\u062f\u0627\u0645\u0629 \u0648\u0634\u0627\u0645\u0644\u0629 \u0644\u0644\u062c\u0645\u064a\u0639\u060c \u0648\u0639\u0644\u0649 \u0627\u0644\u0646\u0647\u0648\u0636 \u0628\u0645\u062d\u0648 \u0627\u0644\u0623\u0645\u064a\u0629 \u0648\u0627\u0644\u062a\u0639\u0644\u0651\u0645 \u0645\u062f\u0649 \u0627\u0644\u062d\u064a\u0627\u0629 \u0648\u062d\u0645\u0627\u064a\u0629 \u062d\u0642 \u0627\u0644\u0645\u0624\u0644\u0641 \u0648\u062d\u0631\u064a\u0629 \u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u0627\u0645 \u0643\u0627\u0645\u0644 \u0645\u0646 \u0627\u0644\u0623\u0646\u0634\u0637\u0629.</p><p>\u062a\u0639\u062f \u0627\u0644\u0643\u062a\u0628 \u0648\u0631\u0648\u0627\u064a\u0629 \u0627\u0644\u0642\u0635\u0635 \u0625\u0631\u062b\u064b\u0627 \u0644\u0644\u0628\u0634\u0631\u064a\u0629. \u0641\u0647\u064a \u0623\u062f\u0648\u0627\u062a \u0642\u0648\u064a\u0629 \u0644\u0644\u062a\u0641\u0643\u064a\u0631 \u0627\u0644\u0646\u0642\u062f\u064a \u0648\u0627\u0644\u062a\u0623\u0645\u0644 \u0648\u0627\u0644\u062a\u062d\u0631\u0631. \u0648\u064a\u064f\u0639\u062f \u0647\u0630\u0627 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0645\u0646 \u0627\u0644\u062d\u0643\u0645\u0629 \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a \u0648\u0633\u064a\u0644\u0629 \u0644\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0648\u0639\u064a \u0628\u0627\u0644\u062a\u0631\u0627\u062b \u0648\u0627\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u060c \u0645\u0645\u0627 \u064a\u0633\u0627\u0647\u0645 \u0641\u064a \u0645\u062f \u062c\u0633\u0648\u0631 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u064a\u0646 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0623\u0639\u0645\u0627\u0631 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u0627\u062a. \u0648\u062a\u0642\u0639 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0639\u0646\u062f \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u0642\u0627\u0621 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0648\u0627\u0644\u062a\u0639\u0644\u064a\u0645\u060c \u0648\u0647\u064a \u062d\u0642 \u0623\u0633\u0627\u0633\u064a \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u064a\u062a\u0645\u062a\u0639 \u0628\u0647 \u0627\u0644\u062c\u0645\u064a\u0639 \u062a\u0645\u062a\u0639\u064b\u0627 \u0643\u0627\u0645\u0644\u0627\u064b \u2013 \u0648\u0647\u0648 \u0645\u0627 \u064a\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u062a\u064a \u0637\u0627\u0644\u0645\u0627 \u062f\u0639\u062a \u0625\u0644\u064a\u0647\u0627 \u0627\u0644\u064a\u0648\u0646\u0633\u0643\u0648.</p><p>\u064a\u0645\u062b\u0651\u0644 \u0643\u0644 \u0633\u062c\u0644 \u0639\u0627\u0635\u0645\u0629 \u0639\u0627\u0644\u0645\u064a\u0629 \u0644\u0644\u0643\u062a\u0627\u0628: \u0627\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u0648\u0627\u0644\u0628\u0644\u062f\u060c \u0648\u0633\u0646\u0629 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631\u060c \u0648\u0627\u0644\u0645\u0642\u062f\u0645\u0629\u060c \u0648\u0627\u0644\u0648\u0635\u0641\u060c \u0648\u0627\u0644\u0634\u0639\u0627\u0631\u060c \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0648\u0627\u0644\u0631\u0648\u0627\u0628\u0637.</p>", "theme": ["Culture"], "theme_en": ["Culture"], "theme_fr": ["Culture"], "theme_es": ["Cultura"], "theme_ar": ["\u0627\u0644\u062b\u0642\u0627\u0641\u0629"], "keyword": ["World Book Capital", "Books", "Reading", "Literacy", "SDG 4: Quality Education", "SDG 11: Sustainable Cities and Communities"], "keyword_en": ["World Book Capital", "Books", "Reading", "Literacy", "SDG 4: Quality Education", "SDG 11: Sustainable Cities and Communities"], "keyword_fr": ["Capitale mondiale du livre", "Livres", "Lecture", "Alphab\u00e9tisation", "ODD 4 : \u00c9ducation de qualit\u00e9", "ODD 11 : Villes et communaut\u00e9s durables"], "keyword_es": ["Capital Mundial del Libro", "Libros", "Lectura", "Alfabetizaci\u00f3n", "ODS 4: Educaci\u00f3n de calidad", "ODS 11: Ciudades y comunidades sostenibles"], "keyword_ar": ["\u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0644\u0644\u0643\u062a\u0627\u0628", "\u0627\u0644\u0643\u062a\u0628", "\u0627\u0644\u0642\u0631\u0627\u0621\u0629", "\u0645\u062d\u0648 \u0627\u0644\u0623\u0645\u064a\u0629", "\u0627\u0644\u0647\u062f\u0641 4 \u0645\u0646 \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u0646\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062f\u0627\u0645\u0629: \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062c\u064a\u062f", "\u0627\u0644\u0647\u062f\u0641 11 \u0645\u0646 \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u0646\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062f\u0627\u0645\u0629: \u0645\u062f\u0646 \u0648\u0645\u062c\u062a\u0645\u0639\u0627\u062a \u0645\u062d\u0644\u064a\u0629 \u0645\u0633\u062a\u062f\u0627\u0645\u0629"], "license": "CC BY-SA 4.0", "license_en": "CC BY-SA 4.0", "license_fr": "CC BY-SA 4.0", "license_es": "CC BY-SA 4.0", "license_ar": "CC BY-SA 4.0", "license_url": "https://creativecommons.org/licenses/by-sa/4.0/", "license_url_en": "https://creativecommons.org/licenses/by-sa/4.0/", "license_url_fr": "https://creativecommons.org/licenses/by-sa/4.0/", "license_url_