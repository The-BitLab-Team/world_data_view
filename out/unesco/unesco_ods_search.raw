ame": "country_title_en", "description": null, "annotations": {}, "label": "Country name", "type": "text", "label_en": "Country name", "label_fr": "Nom du pays", "label_es": "Nombre del pa\u00eds", "label_ar": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0644\u062f", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}, {"name": "regional_group", "description": null, "annotations": {"multivalued": ","}, "label": "Regional group", "type": "text", "label_en": "Regional group", "label_fr": "Groupe r\u00e9gional", "label_es": "Grupo regional", "label_ar": "\u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0625\u0642\u0644\u064a\u0645\u064a\u0629", "description_en": null, "description_fr": null, "description_es": null, "description_ar": null}], "dataset_id": "ioc001", "dataset_uid": "da_hqw0ud", "has_records": true, "features": ["geo", "analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Marine Biodiversity by Ocean Area \u2013 Ocean Biodiversity Information System", "title_en": "Marine Biodiversity by Ocean Area \u2013 Ocean Biodiversity Information System", "title_fr": "Biodiversit\u00e9 marine par zone oc\u00e9anique \u2013 Syst\u00e8me d'information sur la biodiversit\u00e9 oc\u00e9anique", "title_es": "Biodiversidad marina por zona oce\u00e1nica \u2013 Sistema de Informaci\u00f3n sobre Biodiversidad Oce\u00e1nica", "title_ar": "\u0627\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0627\u0644\u0628\u062d\u0631\u064a \u062d\u0633\u0628 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u062d\u064a\u0637 \u2013 \u0646\u0638\u0627\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0644\u0644\u0645\u062d\u064a\u0637\u0627\u062a", "description": "Marine biodiversity indicators for ocean areas worldwide \u2014 exclusive economic zones, high seas (ABNJ) and ecologically significant areas (EBSA) \u2014 built from\u00a0<span style=\"caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-family: Calibri, sans-serif; font-size: 14.666667px; font-style: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration: none; display: inline !important; float: none;\">Ocean Biodiversity Information System (OBIS)</span>\u00a0the IOC-UNESCO global marine biodiversity database. For each area it summarises how many species and taxa have been recorded, the volume of observations, the share of IUCN-threatened species, and the time span of records, helping researchers, policymakers and the public assess and compare marine life across regions and support ocean conservation and SDG 14.", "description_en": "Marine biodiversity indicators for ocean areas worldwide \u2014 exclusive economic zones, high seas (ABNJ) and ecologically significant areas (EBSA) \u2014 built from\u00a0<span style=\"caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-family: Calibri, sans-serif; font-size: 14.666667px; font-style: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration: none; display: inline !important; float: none;\">Ocean Biodiversity Information System (OBIS)</span>\u00a0the IOC-UNESCO global marine biodiversity database. For each area it summarises how many species and taxa have been recorded, the volume of observations, the share of IUCN-threatened species, and the time span of records, helping researchers, policymakers and the public assess and compare marine life across regions and support ocean conservation and SDG 14.", "description_fr": "Indicateurs de biodiversit\u00e9 marine pour les zones oc\u00e9aniques mondiales \u2014 zones \u00e9conomiques exclusives (ZEE), haute mer (ABNJ) et zones \u00e9cologiquement significatives (ZE) \u2014 \u00e9labor\u00e9s \u00e0 partir du Syst\u00e8me d'information sur la biodiversit\u00e9 oc\u00e9anique (OBIS), la base de donn\u00e9es mondiale sur la biodiversit\u00e9 marine de l'IOC-UNESCO. Pour chaque zone, il r\u00e9capitule le nombre d'esp\u00e8ces et de taxons recens\u00e9s, le volume d'observations, la proportion d'esp\u00e8ces menac\u00e9es par l'UICN ainsi que la p\u00e9riode couverte par les enregistrements, permettant aux chercheurs, aux d\u00e9cideurs politiques et au public d'\u00e9valuer et de comparer la vie marine entre les diff\u00e9rentes r\u00e9gions, tout en soutenant la conservation des oc\u00e9ans et l'ODD 14.", "description_es": "Indicadores de biodiversidad marina para las zonas oce\u00e1nicas en todo el mundo \u2014 zonas econ\u00f3micas exclusivas, alta mar (ABNJ) y \u00e1reas ecol\u00f3gicamente significativas (EBSA) \u2014 elaborados a partir del Sistema de Informaci\u00f3n sobre la Biodiversidad Oce\u00e1nica (OBIS), la base de datos global sobre la biodiversidad marina del IOC-UNESCO. Para cada zona, resume el n\u00famero de especies y taxones registrados, el volumen de observaciones, la proporci\u00f3n de especies amenazadas por la UICN y el periodo temporal de los registros, ayudando a investigadores, responsables pol\u00edticos y al p\u00fablico a evaluar y comparar la vida marina entre regiones y apoyar la conservaci\u00f3n de los oc\u00e9anos y el ODS 14.", "description_ar": "\u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0627\u0644\u0628\u062d\u0631\u064a \u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u062d\u064a\u0637\u0627\u062a \u0641\u064a \u062c\u0645\u064a\u0639 \u0623\u0646\u062d\u0627\u0621 \u0627\u0644\u0639\u0627\u0644\u0645 \u2014 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629\u060c \u0623\u0639\u0627\u0644\u064a \u0627\u0644\u0628\u062d\u0627\u0631 (ABNJ)\u060c \u0648\u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0630\u0627\u062a \u0627\u0644\u0623\u0647\u0645\u064a\u0629 \u0627\u0644\u0628\u064a\u0626\u064a\u0629 (EBSA) \u2014 \u0627\u0644\u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 \u0646\u0638\u0627\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0644\u0644\u0645\u062d\u064a\u0637\u0627\u062a (OBIS)\u060c \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0644\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0627\u0644\u0628\u062d\u0631\u064a \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0644\u0644\u062a\u0646\u0633\u064a\u0642 \u0641\u064a \u0627\u0644\u0645\u062c\u0627\u0644\u0627\u062a \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0644\u0644\u0628\u062d\u0627\u0631 (IOC-UNESCO). \u064a\u0644\u062e\u0635 \u0627\u0644\u0646\u0638\u0627\u0645 \u0644\u0643\u0644 \u0645\u0646\u0637\u0642\u0629 \u0639\u062f\u062f \u0627\u0644\u0623\u0646\u0648\u0627\u0639 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0627\u0644\u062d\u064a\u0648\u064a\u0629 \u0627\u0644\u0645\u0633\u062c\u0644\u0629\u060c \u0648\u062d\u062c\u0645 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a\u060c \u0648\u0646\u0633\u0628\u0629 \u0627\u0644\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0645\u0647\u062f\u062f\u0629 \u0628\u0627\u0644\u0627\u0646\u0642\u0631\u0627\u0636 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u062f\u0648\u0644\u064a \u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0637\u0628\u064a\u0639\u0629 (IUCN)\u060c \u0648\u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0644\u0644\u0633\u062c\u0644\u0627\u062a\u060c \u0645\u0645\u0627 \u064a\u0633\u0627\u0639\u062f \u0627\u0644\u0628\u0627\u062d\u062b\u064a\u0646 \u0648\u0635\u0646\u0627\u0639 \u0627\u0644\u0642\u0631\u0627\u0631 \u0648\u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0639\u0644\u0649 \u062a\u0642\u064a\u064a\u0645 \u0648\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629 \u0648\u062f\u0639\u0645 \u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u062d\u064a\u0637\u0627\u062a \u0648\u0627\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u0646\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062f\u0627\u0645\u0629 \u0631\u0642\u0645 14.", "theme": ["Sciences"], "theme_en": ["Sciences"], "theme_fr": ["Sciences"], "theme_es": ["Ciencias"], "theme_ar": ["\u0627\u0644\u0639\u0644\u0648\u0645"], "keyword": ["SDG 14 \u2014 Life Below Water", "Marine biodiversity", "IUCN Red List", "Marine World Heritage", "Ocean", "Large Marine Ecosystem"], "keyword_en": ["SDG 14 \u2014 Life Below Water", "Marine biodiversity", "IUCN Red List", "Marine World Heritage", "Ocean", "Large Marine Ecosystem"], "keyword_fr": ["ODD 14 \u2014 Vie aquatique", "Biodiversit\u00e9 marine", "Liste rouge de l'UICN", "Patrimoine mondial marin", "Oc\u00e9an", "Grand \u00e9cosyst\u00e8me marin"], "keyword_es": ["ODS 14 \u2014 Vida submarina", "Biodiversidad marina", "Lista Roja de la UICN", "Patrimonio Mundial Marino", "Oc\u00e9ano", "Ecosistema marino extenso"], "keyword_ar": ["\u0627\u0644\u0647\u062f\u0641 14 \u0645\u0646 \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u06