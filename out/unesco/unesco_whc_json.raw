    analytics:{supportsCacheHint: true}
  },*/
    elevationInfo: {
  mode: "on-the-ground"
},
  spatialReference: {
    wkid: 4326
  },
  definitionExpression:bufferdefExpression ,
  popupTemplate: {
   title: '{property_id} {property_name_en} - Buffer Zone',
   lastEditInfoEnabled: false,
   content: '<strong>{property_name_en}</strong><br>Buffer Zone<br>{element_serial_number}<br>{element_name_en}<br>{element_state}',
 }
});
