										store.getProxy().setExtraParam( 'list_selected', '' );
										store.getProxy().setExtraParam( 'list_filter', '' );
									}
								}
							}),
							autoLoadOnValue:false,
							listeners: {
								beforerender:function(field, newValue, eOpts){
									
								},
								change: function(field, newValue, oldValue) {
									var hiddenInput = document.getElementById('boxselectval_selector_3');
									hiddenInput.value = newValue;
									this.inputEl.dom.value='';
								}
								,select: function(combo,record,eOpts){
									/*if(this.getPicker().isVisible()){this.getPicker().alignTo(combo);}*/
									
								}
							},
							/*value : [""],*/
							emptyText: '',
							queryMode: 'remote',
							scrollable : true,
							forceSelection: false,
