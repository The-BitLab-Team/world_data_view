					<script data-cfasync="false">
						/* Bootstrap 4 callers pass .modal("show") or .modal({show:true}). Install immediately so deferred footer scripts can open dialogs before DOMContentLoaded. Bootstrap 5 then replaces jQuery.fn.modal on DOMContentLoaded with an interface that ignores {show:true}, so install again after that. */
						(function () {
							function install() {
								if (!window.jQuery || !window.bootstrap || !window.bootstrap.Modal) {
									return false;
								}
								window.jQuery.fn.modal = function (option) {
									return this.each(function () {
										var config = {};
										var action = null;
										var show = true;
										if (typeof option === "string") {
											action = option;
											show = false;
										} else if (option && typeof option === "object") {
											if (Object.prototype.hasOwnProperty.call(option, "show")) {
												show = option.show !== false;
											}
											if (option.backdrop !== undefined) {
												config.backdrop = option.backdrop;
											}
											if (option.keyboard !== undefined) {
												config.keyboard = option.keyboard;
											}
											if (option.focus !== undefined) {
												config.focus = option.focus;
											}
										}
										var instance = window.bootstrap.Modal.getOrCreateInstance(this, config);
										if (action === "hide") {
											instance.hide();
										} else if (action === "toggle") {
											instance.toggle();
										} else if (action === "dispose") {
											instance.dispose();
										} else if (action === "handleUpdate" && instance.handleUpdate) {
											instance.handleUpdate();
										} else if (action === "show" || show) {
											instance.show();
										}
									});
								};
								return true;
							}
							install();
							if (document.readyState === "loading") {
								document.addEventListener("DOMContentLoaded", install);
							}
						})();
					</script>
