			<script language="javascript" type="e4be7c1b0ec69aa835e19a65-text/javascript">
				(function () {
					if (window.history && history.replaceState && /%2C/i.test(location.search)) {
						history.replaceState(null, '', location.pathname + location.search.replace(/%2C/gi, ',') + location["hash"]);
					}
				})();
				Ext.onReady(function(){
					Ext.get('sites_search',true).on('submit', function(event) {
						var form = this.dom;
						var els = this.query('input[value=""]',true);
						var elsSelect = this.query('select',true);
						var parts = [];
						var i = 0;
						var el = null;
						var val = "";
						var action = "";
						Ext.Array.each(els,function(ael){
							if(ael.value==""){ael.disabled=true;}
						});
						Ext.Array.each(elsSelect,function(ael){
							if(ael.value==""){ael.disabled=true;}
						});
						event.preventDefault();
						for (i = 0; i < form.elements.length; i = i + 1) {
							el = form.elements[i];
							if (!el || el.disabled || !el.name) {
								continue;
							}
							if (el.type === 'submit' || el.type === 'button' || el.type === 'file') {
								continue;
							}
							if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) {
								continue;
							}
							val = (el.value == null) ? '' : String(el.value);
							if (!val.length) {
								continue;
							}
							if (el.name.toLowerCase() === 'order' && val.toLowerCase() === 'country') {
								continue;
							}
							if (el.name.toLowerCase() === 'components' && val === '1') {
								continue;
							}
							parts.push(encodeURIComponent(el.name) + '=' + encodeURIComponent(val).replace(/%2C/gi, ','));
						}
						action = form.getAttribute('action') || '';
						window.location = action + (parts.length ? ((action.indexOf('?') >= 0 ? '&' : '?') + parts.join('&')) : '');
					});
				});
			</script>
		
   <script type="e4be7c1b0ec69aa835e19a65-text/javascript">
  /* Set the locale before the JSAPI loads */
    esriConfig = {
      locale: "en",
      log: {level:"none"},
      request: {priority: "low"},
      parseOnLoad: true
    };
  </script>

<script src="https://js.arcgis.com/4.31/" defer type="e4be7c1b0ec69aa835e19a65-text/javascript"></script>

  
  <script type="e4be7c1b0ec69aa835e19a65-text/javascript">
  window.addEventListener('load', () => {
    var
    markersRendererCultural,
    markersRendererNatural,
    markersRendererMixed,
    layerPolybuffer,
    layerPolycore,
    onePoint,
    combinedExtent,
    layerextended = false,
    markerSymbol,
    graphicsCultural = [],
    graphicsNatural = [],
    graphicsMixed = [],
    graphicsCulturalDanger = [],
    graphicsNaturalDanger = [],
    graphicsMixedDanger = [];
    require([
     "require",
     "esri/Map",
     "esri/views/MapView",
     "esri/views/SceneView",
     "esri/WebMap",
     "esri/WebScene",
     "esri/Basemap",
     "esri/widgets/BasemapGallery",
     "esri/widgets/Expand",
     "esri/layers/FeatureLayer",
     "esri/layers/SceneLayer",
     "esri/layers/ElevationLayer",
     "esri/layers/MapImageLayer",
     "esri/widgets/Legend",
     "esri/config",
     "esri/request",
     "esri/widgets/Fullscreen",
     /*"esri/widgets/Search",*/
     "esri/intl",
     "esri/Graphic",
     "esri/symbols",
     "esri/renderers/Renderer",
     "esri/widgets/CoordinateConversion",
     "esri/widgets/Expand",
     "esri/widgets/Measurement",
     "esri/widgets/ScaleBar",
     "esri/geometry/Point",
     "esri/geometry/Extent",
     "esri/geometry/geometryEngine",
     "esri/geometry/projection",
     "esri/geometry/SpatialReference"

     ], function(
     require,
     Map,
     MapView,
     SceneView,
     WebMap,
     WebScene,
     Basemap,
     BasemapGallery,
     Expand,
     FeatureLayer,
     SceneLayer,
     ElevationLayer,
     MapImageLayer,
     Legend,
     esriConfig,
     esriRequest,
     Fullscreen,
     /*Search,*/
     intl,
     Graphic,
     Symbol,
     Renderer,
     CoordinateConversion,
     Expand,
     Measurement,
     ScaleBar,
     Point,
     Extent,
     geometryEngine,
     projection,
     SpatialReference,

     arrayUtils) {
     /*code to create the map and add a basemap will go here*/
       const switchButton = document.getElementById("switch-btn");
       const basemapsetellite = new Basemap({
         title: "Satellite",
         language: "en",
         portalItem: {
          id: "13a1167266ae4d3d8f76a6bf2edd17aa"
        }
      });
       
       const basemapwhc = new Basemap({
         title: "Gray",
         /*thumbnailUrl: "https://unesco.maps.arcgis.com/sharing/rest/content/items/073cf5b02f654359b656f58ca9e67846/info/thumbnail/thumbnail1601627787898.png",*/
         portalItem: {
           id: "073cf5b02f654359b656f58ca9e67846"
         }
       });
       const basemapdark = new Basemap({
         title: "Dark",
         language: "en",
         portalItem: {
          id: "600ffbf85c704aa5a492f018b1125863"
        }
      });
       const basemapTopo = new Basemap({
         title: "Topographic",
         language: "en",
         portalItem: {
          id: "f14d34580ef7460ab71284cf19d1de24"
        }
      });
       const map = new Map({
         basemap: basemapsetellite,
         id: "mainWHCmap",
         ground: "world-elevation" // Enables 3D terrain
       });

       window.appConfig = window.appConfig || {};
       const appConfig = {
         mapView: null,
         sceneView: null,
         activeView: null,
         container: "esrimap"
       };
       const initialViewParams2D = {
         zoom: 2,
         //scale: 40000,
         map: map,
         center: [0, 0],
         container: appConfig.container,
         id: "2dview",
         constraints: {
          snapToZoom: false
        }
      };
      const initialViewParams3D = {
       zoom: 2,
       map: map,
       container: appConfig.container,
         /*ground: {
            layers: [ new ElevationLayer({
              url: "https://elevation3d.arcgis.com/arcgis/rest/services/WorldElevation3D/Terrain3D/ImageServer"
            })]
          },*/
       id: "3dview"
     };
     /*create 2D view and and set active*/
     appConfig.mapView = createView(initialViewParams2D, "2d");
     /*appConfig.mapView.map = map;*/

     appConfig.mapView.when(function() {

      document.getElementById("infoDiv").style.display = "block";
    }).catch(function() {
         /* View was rejected, show webgl unsupported message and turn off the viewDiv*/
     document.getElementById("infoWebGL").style.display = "block";
   });

    try{
      window.appConfig = appConfig;
      window.markerSymbol = markerSymbol;
      if(typeof featuresLayer !== 'undefined') {
        window.featuresLayer = featuresLayer;
      }
    } catch(e){ 
      console.error('v430: error exposing globals', e); 
    }

    appConfig.mapView.when().then(function(){
      try {
        if (typeof featuresLayer !== 'undefined') {
          window.featuresLayer = window.featuresLayer || featuresLayer;
        }
        var detail = { appConfig: appConfig, markerSymbol: markerSymbol };
        if (window.featuresLayer) { detail.featuresLayer = window.featuresLayer; }
        window.dispatchEvent(new CustomEvent('esri-map-ready', { detail: detail }));
      }catch(e){ 
        console.error('v430: dispatch esri-map-ready failed', e); 
      }
    });

    appConfig.activeView = appConfig.mapView;
     /* create 3D view, won't initialize until container is set*/
    initialViewParams3D.container = null;
    appConfig.sceneView = createView(initialViewParams3D, "3d");
    appConfig.sceneView.map.ground= "world-elevation";
       /*appConfig.sceneView.spatialReference= {isWrappable:true};*/
    symbolSizeScale(appConfig.activeView);
