    queryTopFeatures :{supportsCacheHint: true},
    attachment:{supportsCacheHint: true},
    analytics:{supportsCacheHint: true}
  },*/
      elevationInfo: {
  mode: "on-the-ground"
},
    spatialReference: {
      wkid: 4326
    },
    definitionExpression : layerPolycoredefinitionExpression,
    popupTemplate: {
      title: '{element_serial_number} {element_name_en} ({element_state}) / Property',
      content: '<strong><a href="https\x3A\x2F\x2Fwhc.unesco.org\x2Fen\x2Flist\x2F{property_id}" target="_self">{property_name_en}</a></strong><br>Property<br>{element_serial_number}<br>{element_name_en}<br>{element_state}',
      lastEditInfoEnabled: false
    }
  });
  layerPolycore.renderer=
  {
    type: "simple",
    symbol: {
      type: "simple-fill",
      color: [232,63,64,.4],
      style:"solid",
      opacity:.5,
      outline: {
        type: "simple-line",
        color: [232,63,64,.8],
        width: 1.5
      }
    }
  };
  map.add(layerPolycore);
  /* buffer layer */
  if(response.data.allSps){
   
   bufferdefExpression = "property_id IN ("+response.data.allIds+")  AND ( element_iso2 IS NULL OR element_iso2 IN ('"+response.data.allSps+"'))";
 } else {
  
    bufferdefExpression = "property_id IN ("+response.data.allIds+")";
  
}
layerPolybuffer = new FeatureLayer({
  id:"allpolybuffer",
  title:"Buffer Zone with polygones",
 
   url: "https://services6.arcgis.com/eMd5K6XXEvJETxfQ/arcgis/rest/services/prd_whc_sites_dossiers_elements_v2_view/FeatureServer/2",
  outFields: ["*"],
/*  capabilities:{
