   geometryType: "point",
   objectIdField: "ObjectID",
   popupTemplate: pTemplate,
   renderer: markersRendererNatural
 });
 map.add(layerNatural);
}
if (graphicsMixed.length > 0) {
 var layerMixed = new FeatureLayer({
