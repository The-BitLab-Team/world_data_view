#infoDiv{
position: absolute;
top: 15px;
left: 60px;
z-index:1;
display:none;
}
#infoDiv input {
border: none;
box-shadow:  rgba(0, 0, 0, 0.3) 0px 1px 2px;
}
#infoWebGL{display:none;}
.esri-ui {position:initial}
