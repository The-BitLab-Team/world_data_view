   renderer: markersRendererMixed
 });
 map.add(layerMixed);

}
if (graphicsCulturalDanger.length > 0) {
 var layerCulturalDanger = new FeatureLayer({
   source: graphicsCulturalDanger,
   fields: fields,
   geometryType: "point",
   id: "layerCulturalDanger",
   title:"Cultural and in danger properties (point data)",
   objectIdField: "ObjectID",
   popupTemplate: pTemplate,
   renderer: markersRendererCulturalDanger
 });
 map.add(layerCulturalDanger);

}
if (graphicsNaturalDanger.length > 0) {
 var layerNaturalDanger = new FeatureLayer({
   id: "layerNaturalDanger",
   source: graphicsNaturalDanger,
   title:"Natural and in danger properties (point data)",
   fields: fields,
   geometryType: "point",
   objectIdField: "ObjectID",
   popupTemplate: pTemplate,
   renderer: markersRendererNaturalDanger
 });
 map.add(layerNaturalDanger);

}
if (graphicsMixedDanger.length > 0) {
 var layerMixedDanger = new FeatureLayer({
   id: "layerMixedDanger",
   source: graphicsMixedDanger,
   title:"Mixed and in danger properties (point data)",
   fields: fields,
   geometryType: "point",
   objectIdField: "ObjectID",
   popupTemplate: pTemplate,
   renderer: markersRendererMixedDanger
 });
 map.add(layerMixedDanger);
}

   appConfig.activeView.when(function() {

combineLayerExtents(map.layers);
});
}
});


});
  });
</script>

		<script type="e4be7c1b0ec69aa835e19a65-text/javascript" defer='defer'>
			$('.lightbox').on('click',function(e){
				e.preventDefault();
				let iframeSrc=$(this).attr('href');
				let myHtml = $('html');
				let scrollPosY =  myHtml.scrollTop();
				$('.lightboxIframe').on('shown.bs.modal',function(){
					myHtml.css('overflow','hidden');
					$(this).find('iframe').attr('src',iframeSrc);
					$(this).css('padding-right','');
				})
				$('.lightboxIframe').on('hidden.bs.modal',function(){
					/*myHtml.toggleClass("scrollbarnone");*/
					myHtml.css("scroll-behavior","auto");
					myHtml.scrollTop(scrollPosY);
					myHtml.css("scroll-behavior","");
				});
				$('.lightboxIframe').on('hide.bs.modal',function(){
					$(this).find('iframe').attr('src','');
					myHtml.css('overflow','');
				})
				$('#lightboxIframe').modal({keyboard: true,show:true});
			}
			);
			/* Capture phase: .contactButton is sometimes an <a href>, and the browser follows that URL if this runs only on bubble. */
			document.addEventListener('click', function (e) {
				if (e.button !== 0) {
					return;
				}
				var trigger = e.target && e.target.closest ? e.target.closest('.contactButton') : null;
				if (!trigger) {
					return;
				}
				e.preventDefault();
				e.stopPropagation();
				var keywordValue = $(trigger).attr('keyword');
				$('.contactIframe').on('shown.bs.modal', function () {
					$(this).find('iframe').attr('src', "/include/tool_contact_bootstrap.cfm" + "?keyword=" + keywordValue);
				});
				$('.contactIframe').on('hidden.bs.modal', function () {
					$(this).find('iframe').attr('src', '');
				});
				$('#contactIframe').modal({keyboard: true, show: true});
			}, true);
			document.addEventListener('auxclick', function (e) {
				var trigger = e.target && e.target.closest ? e.target.closest('.contactButton') : null;
				if (!trigger || e.button === 2) {
					return;
				}
				e.preventDefault();
			}, true);
		</script>
	
<script data-cfasync="false" type='text/javascript' defer='defer'>$('#alertLogin').on('shown.bs.modal', function () {
    $(this).css('z-index', 2050);
